@model DemoMVC.Models.Product

<h2>Sửa sản phẩm</h2>

<form asp-action="Edit" method="post">
    
    <!-- QUAN TRỌNG -->
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Tên:</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Giá:</label>
        <input asp-for="Price" />
    </div>

    <button type="submit">Cập nhật</button>
</form>